    subscriptions ||--o{ subscription_events : "transitions through"
    subscriptions ||--o{ invoices : "recurringly generates"

    subscription_lines ||--o{ invoice_lines : "manifests as"
    invoices ||--|{ invoice_lines : "contains"
    invoices ||--o{ discount_applications : "reduced by"
    invoices ||--o{ payment_allocations : "settled through"

