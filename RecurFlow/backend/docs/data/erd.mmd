    product_variants ||--o{ quotation_lines : "selected in"
    product_variants ||--o{ subscription_lines : "selected in"

    tax_rates ||--o{ quotation_lines : "applied to"
    tax_rates ||--o{ subscription_lines : "configured in"

    plans ||--o{ plan_items : "bundles"
    plans ||--o{ subscriptions : "governs cadence of"
    plans ||--o{ quotation_lines : "packaged in"

    quotation_templates ||--o{ quotations : "templates"
    quotations ||--|{ quotation_lines : "contains"
    quotations ||--o| subscriptions : "converts into"
    quotation_lines ||--o{ subscription_lines : "lineage for"

    subscriptions ||--o| subscriptions : "renewed from"
