# Application Configuration
APP_NAME=RecurFlow
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL 16+)
DATABASE_URL=postgresql+psycopg://recurflow:change_me@localhost:5432/recurflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Security & Authentication
# In production, replace with a 64+ char random hex string (e.g., openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_characters_long_for_security
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration (comma-separated list of allowed origins; no wildcards in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging Configuration
LOG_LEVEL=INFO
